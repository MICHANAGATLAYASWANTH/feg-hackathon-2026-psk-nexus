# FEG Hackathon 2026 - Security & Confidentiality Rules
# Strictly exclude sensitive keys, credentials, and real data

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# Real customer/player data & large datasets
*.csv
*.xlsx
*.parquet
*.dump
*.sql
*.tar.gz
!assets/sample_*.json

# Dependencies
node_modules/
dist/
dist-ssr/
build/
*.local

# Logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.pnpm-debug.log*

# OS and Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
