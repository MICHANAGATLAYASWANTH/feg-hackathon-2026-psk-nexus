# PSK Nexus - Environment Configuration Template
# Copy this file to .env for local deployment (do NOT commit real secrets to source control)

# Application Environment
NODE_ENV=development
PORT=3000
HOST=localhost

# Brand & Market Configuration
MARKET=HR
BRAND=PSK
DEFAULT_CURRENCY=EUR
LANGUAGE=hr

# Session Quality Index (SQI) Thresholds
SQI_TARGET_SCORE=85.0
SQI_TTFB_BASELINE_SEC=408
SQI_HEALTHY_SESSION_MAX_MIN=60

# Croatian Regulatory & Responsible Gaming Configuration
CROATIA_MIN_AGE=18
CROATIA_MANIPULATION_FEE_PCT=0.05
REGISTER_CHECK_SIMULATION=true
RG_VELOCITY_BET_ALERT_THRESHOLD=4
RG_MAX_DAILY_DEFAULT_EUR=50.0

# API & Service Endpoints (Mocked for POC Evaluation)
COPILOT_API_ENDPOINT=http://localhost:3000/api/copilot
SQI_TELEMETRY_ENDPOINT=http://localhost:3000/api/telemetry
